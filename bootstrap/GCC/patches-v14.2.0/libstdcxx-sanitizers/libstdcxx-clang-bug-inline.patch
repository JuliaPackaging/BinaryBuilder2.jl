From bc63f41cdd806b0c41f037a21da8fa77a90383f7 Mon Sep 17 00:00:00 2001
From: Elliot Saba <staticfloat@gmail.com>
Date: Tue, 10 Nov 2026 08:06:53 -0800
Subject: [PATCH 2/2] libstdc++: stop inlining exception_ptr

Clang does not emit the C1 constructor and D1 destructor for inline
functions marked `__attribute__((used))`, so a clang-built libstdc++
lacks the exported complete-object `exception_ptr` constructors and
destructor. Define them, `operator=` and `swap` out of line in eh_ptr.cc
instead.

Ported to GCC 14 from Keno Fischer's GCC 12 patch in Yggdrasil
L/LibStdCxx/bundled/patches/gcc-12-clang-bug-inline.patch.
---
 libstdc++-v3/libsupc++/eh_ptr.cc       | 33 +++++++++++++++++++++
 libstdc++-v3/libsupc++/exception_ptr.h | 41 --------------------------
 2 files changed, 33 insertions(+), 41 deletions(-)

diff --git a/libstdc++-v3/libsupc++/eh_ptr.cc b/libstdc++-v3/libsupc++/eh_ptr.cc
index d93bb2a..81c5f8c 100644
--- a/libstdc++-v3/libsupc++/eh_ptr.cc
+++ b/libstdc++-v3/libsupc++/eh_ptr.cc
@@ -220,4 +220,37 @@ std::rethrow_exception(std::exception_ptr ep)
   std::terminate();
 }
 
+std::exception_ptr::exception_ptr() _GLIBCXX_USE_NOEXCEPT
+: _M_exception_object(0)
+{ }
+
+std::exception_ptr::exception_ptr(const std::exception_ptr& __other)
+_GLIBCXX_USE_NOEXCEPT
+: _M_exception_object(__other._M_exception_object)
+{
+  if (_M_exception_object)
+    _M_addref();
+}
+
+std::exception_ptr::~exception_ptr() _GLIBCXX_USE_NOEXCEPT
+{
+  if (_M_exception_object)
+    _M_release();
+}
+
+std::exception_ptr&
+std::exception_ptr::operator=(const std::exception_ptr& __other) _GLIBCXX_USE_NOEXCEPT
+{
+  exception_ptr(__other).swap(*this);
+  return *this;
+}
+
+void
+std::exception_ptr::swap(std::exception_ptr &__other) _GLIBCXX_USE_NOEXCEPT
+{
+  void *__tmp = _M_exception_object;
+  _M_exception_object = __other._M_exception_object;
+  __other._M_exception_object = __tmp;
+}
+
 #undef _GLIBCXX_EH_PTR_COMPAT
diff --git a/libstdc++-v3/libsupc++/exception_ptr.h b/libstdc++-v3/libsupc++/exception_ptr.h
index 7c234ce..4027b7b 100644
--- a/libstdc++-v3/libsupc++/exception_ptr.h
+++ b/libstdc++-v3/libsupc++/exception_ptr.h
@@ -184,47 +184,6 @@ namespace std _GLIBCXX_VISIBILITY(default)
 	__attribute__ ((__pure__));
     };
 
-    _GLIBCXX_EH_PTR_USED
-    inline
-    exception_ptr::exception_ptr() _GLIBCXX_USE_NOEXCEPT
-    : _M_exception_object(0)
-    { }
-
-    _GLIBCXX_EH_PTR_USED
-    inline
-    exception_ptr::exception_ptr(const exception_ptr& __other)
-    _GLIBCXX_USE_NOEXCEPT
-    : _M_exception_object(__other._M_exception_object)
-    {
-      if (_M_exception_object)
-	_M_addref();
-    }
-
-    _GLIBCXX_EH_PTR_USED
-    inline
-    exception_ptr::~exception_ptr() _GLIBCXX_USE_NOEXCEPT
-    {
-      if (_M_exception_object)
-	_M_release();
-    }
-
-    _GLIBCXX_EH_PTR_USED
-    inline exception_ptr&
-    exception_ptr::operator=(const exception_ptr& __other) _GLIBCXX_USE_NOEXCEPT
-    {
-      exception_ptr(__other).swap(*this);
-      return *this;
-    }
-
-    _GLIBCXX_EH_PTR_USED
-    inline void
-    exception_ptr::swap(exception_ptr &__other) _GLIBCXX_USE_NOEXCEPT
-    {
-      void *__tmp = _M_exception_object;
-      _M_exception_object = __other._M_exception_object;
-      __other._M_exception_object = __tmp;
-    }
-
     /// @relates exception_ptr
     inline void
     swap(exception_ptr& __lhs, exception_ptr& __rhs)
